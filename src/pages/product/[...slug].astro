---
import { render } from "astro:content";
import ProductInfo from "@/components/features/product/ProductInfo.astro";
import ContentEntryBody from "@/components/shared/ContentEntryBody.astro";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { containsMath } from "@/lib/math";
import { getProductPosts } from "@/lib/post";

export async function getStaticPaths() {
	const productEntries = await getProductPosts();
	return productEntries.map((entry) => ({
		params: { slug: entry.data.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;

const { Content, headings } = await render(entry);
const articleInfo = {
	title: entry.data.title,
	slug: entry.data.slug,
	publishDate: entry.data.publishDate,
	updateDate: entry.data.updateDate,
	tags: entry.data.tags || [],
	thumbnail: entry.data.thumbnail ?? (entry.data.carousel?.[0] || null),
	carousel: entry.data.carousel,
	description: entry.data.description || "",
	content: entry.body, // 読了時間計算用
};
---

<BlogLayout
  title={entry.data.title}
  headings={headings}
  frontmatter={articleInfo}
  collection="product"
  hasMath={containsMath(entry.body ?? "")}
>
  <ProductInfo {...articleInfo} />

  <ContentEntryBody
    collection="product"
    slug={entry.data.slug}
    title={articleInfo.title}
    description={articleInfo.description}
    headings={headings}
    isPublish={entry.data.isPublish}
  >
    <Content />
  </ContentEntryBody>
</BlogLayout>
