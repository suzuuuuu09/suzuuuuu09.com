---
import { css } from "styled-system/css";
import { Flex, HStack, styled as s } from "styled-system/jsx";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";
import Avatar from "@/components/ui/Avatar.astro";
import type { NavigationLink } from "@/types";
import { getCurrentSection } from "@/utils/navigation";
import MobileNavigation from "./MobileNavigation.astro";
import Navigation from "./Navigation";

export const NAVIGATION_LINKS: NavigationLink[] = [
	{ href: "/about", label: "About" },
	{ href: "/product", label: "Products" },
	{ href: "/blog/", sectionPath: "/blog", label: "Blogs" },
];

const currentSection = getCurrentSection(Astro.url.pathname, NAVIGATION_LINKS);
---

<s.a
  href="#main-content"
  position="fixed"
  top="2"
  left="2"
  zIndex="1101"
  transform="translateY(-200%)"
  px="4"
  py="2"
  borderRadius="md"
  background="sz.bg-on"
  color="sz.text.main"
  boxShadow="lg"
  fontWeight="bold"
  _focusVisible={{ transform: "translateY(0)" }}
>
  本文へスキップ
</s.a>

<s.header
  data-site-header
  position="fixed"
  top="1rem"
  left="50%"
  transform="translateX(-50%)"
  width="calc(100% - 2rem)"
  maxW="5xl"
  overflow="visible"
  zIndex="1000"
  background="sz.bg-on/50"
  border="1px solid"
  borderColor="sz.border/20"
  borderRadius="full"
  color="sz.text.main"
  boxShadow="xl"
  backdropFilter="blur(12px)"
  transition="all 0.4s cubic-bezier(0.4, 0, 0.2, 1)"
>
  <s.nav
    aria-label="Site header"
    display="flex"
    alignItems="center"
    justifyContent="space-between"
    px={{ base: "4", lg: "9" }}
    py="3"
    position="relative"
  >
    <HStack gap={{ base: "2", lg: "4" }} minW="0" flex="1" overflow="hidden">
      <s.a href="/" display="flex" alignItems="center" gap="3" minW="0">
        <div id="avatar-container">
          <Avatar size={24} />
        </div>
        <s.span
          fontSize={{ base: "sm", lg: "xl" }}
          m="0"
          opacity="0.9"
          fontWeight="bold"
          color="sz.text.main"
          whiteSpace="nowrap"
          overflow="hidden"
          textOverflow="ellipsis">suzuuuuu09.com</s.span
        >
      </s.a>
      <Flex alignItems="center" gap="3" position="relative" flex="1" minW="0">
        <Navigation
          links={NAVIGATION_LINKS}
          currentSection={currentSection}
          client:media="(min-width: 1024px)"
        />
      </Flex>
    </HStack>

    <HStack gap="3" flexShrink="0" position="relative" zIndex="1">
      <ThemeToggle />
      <s.a
        href="/rss.xml"
        aria-label="RSS Feed"
        className={css({ display: { base: "none", lg: "inline-flex" } })}
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          class={css({
            color: "sz.text.main",
          })}
          aria-hidden="true"
        >
          <path d="M5 17a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" fill="currentColor"></path>
          <path d="M4 10a10 10 0 0 1 10 10"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
        </svg>
      </s.a>
      <MobileNavigation
        links={NAVIGATION_LINKS}
        currentSection={currentSection}
      />
    </HStack>
  </s.nav>
</s.header>

<script>
  // 「↑↑↓↓←→←→BA」を検出するためのKONAMIコマンド入力値
  const konamiCode = [38, 38, 40, 40, 37, 39, 37, 39, 66, 65];
  let konamiIndex = 0;

  // KONAMIコマンド取得用のキーコードマップ
  const keyMap: { [key: string]: number } = {
    ArrowUp: 38,
    ArrowDown: 40,
    ArrowLeft: 37,
    ArrowRight: 39,
    b: 66,
    B: 66,
    a: 65,
    A: 65,
  };

  // KONAMIコマンドを検出
  document.addEventListener("keydown", function (e) {
    const keyValue = keyMap[e.key];

    if (keyValue === konamiCode[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === konamiCode.length) {
        // アバターのcontainerを取得
        const avatarContainer = document.getElementById("avatar-container");
        if (!avatarContainer) return; // アバターが存在しない場合は実行しない

        avatarContainer.animate(
          [
            { transform: "rotate(0deg) scale(1)" },
            { transform: "rotate(360deg) scale(1.3)", offset: 0.6 },
            { transform: "rotate(360deg) scale(1)" },
          ],
          { duration: 1000, easing: "ease-in-out" },
        );

        konamiIndex = 0;
      }
    } else {
      konamiIndex = 0;
    }
  });
</script>
