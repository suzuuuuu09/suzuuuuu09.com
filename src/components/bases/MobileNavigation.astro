---
import { Icon } from "@suzuuuuu09/astro-iconify";
import { css } from "styled-system/css";
import type { NavigationLink } from "@/types";

interface Props {
	links: NavigationLink[];
	currentSection?: string;
}

const { links, currentSection } = Astro.props;

const toggleClass = css({
	position: "relative",
	display: { base: "grid", lg: "none" },
	placeItems: "center",
	p: "2",
	borderRadius: "md",
	bg: "sz.bg-on",
	border: "1px solid",
	borderColor: "sz.border",
	color: "sz.text.main",
	cursor: "pointer",
	transition:
		"background-color var(--durations-fast) var(--easings-out), transform var(--durations-faster) var(--easings-out)",
	_hover: {
		bg: "sz.bg-on.500",
	},
	_active: {
		transform: "translateY(1px)",
	},
	_focusVisible: {
		outline: "2px solid",
		outlineColor: "sz.primary",
		outlineOffset: "2px",
	},
	_disabled: {
		opacity: "0.5",
		cursor: "not-allowed",
	},
});

const panelClass = css({
	p: "2",
	bg: "sz.bg-on.500",
	border: "1px solid",
	borderColor: "sz.border/20",
	borderRadius: "xl",
	color: "sz.text.main",
	boxShadow: "xl",
	backdropFilter: "blur(12px)",
});

const linkClass = css({
	display: "flex",
	alignItems: "center",
	justifyContent: "space-between",
	minH: "11",
	px: "4",
	py: "2",
	borderRadius: "lg",
	color: "sz.text.main",
	fontWeight: "bold",
	textDecoration: "none",
	whiteSpace: "nowrap",
	transition:
		"background-color var(--durations-fast) var(--easings-out), color var(--durations-fast) var(--easings-out), transform var(--durations-faster) var(--easings-out)",
	_hover: {
		bg: "sz.primary/10",
		color: "sz.primary",
	},
	_active: {
		transform: "translateY(1px)",
	},
	_focusVisible: {
		outline: "2px solid",
		outlineColor: "sz.primary",
		outlineOffset: "-2px",
	},
});

const currentLinkClass = css({
	position: "relative",
	bg: "sz.primary/10",
	color: "sz.primary",
	_before: {
		content: '""',
		position: "absolute",
		insetBlock: "0.5rem",
		left: "0",
		width: "3px",
		borderRadius: "full",
		bg: "sz.primary",
	},
});
---

<div class={css({ display: { base: "inline-flex", lg: "none" } })}>
  <button
    type="button"
    class:list={[toggleClass, "mobile-navigation__toggle"]}
    aria-label="メニューを開く"
    aria-controls="mobile-navigation-panel"
    aria-expanded="false"
    popovertarget="mobile-navigation-panel"
    popovertargetaction="toggle"
    data-mobile-navigation-toggle
  >
    <Icon
      name="mdi:menu"
      width="20"
      height="20"
      class="mobile-navigation__icon mobile-navigation__icon--menu"
      aria-hidden="true"
    />
    <Icon
      name="mdi:close"
      width="20"
      height="20"
      class="mobile-navigation__icon mobile-navigation__icon--close"
      aria-hidden="true"
    />
  </button>

  <nav
    id="mobile-navigation-panel"
    aria-label="Mobile navigation"
    popover="auto"
    class:list={[panelClass, "mobile-navigation__panel"]}
    data-mobile-navigation-panel
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={currentSection === link.href ? "location" : undefined}
          class:list={[
            linkClass,
            "mobile-navigation__link",
            currentSection === link.href && currentLinkClass,
          ]}
          data-astro-prefetch
        >
          <span>{link.label}</span>
          <span aria-hidden="true">→</span>
        </a>
      ))
    }

    <div
      class={css({
        mt: "2",
        pt: "2",
        borderTop: "1px solid",
        borderColor: "sz.border/20",
      })}
    >
      <a
        href="/rss.xml"
        class:list={[linkClass, "mobile-navigation__link"]}
        data-astro-prefetch
      >
        <span>RSS Feed</span>
        <Icon name="mdi:rss" width="20" height="20" aria-hidden="true" />
      </a>
    </div>
  </nav>
</div>

<script>
  const MOBILE_NAV_PANEL_SELECTOR = "[data-mobile-navigation-panel]";
  const MOBILE_NAV_TOGGLE_SELECTOR = "[data-mobile-navigation-toggle]";

  function syncToggle(toggle: HTMLButtonElement, open: boolean) {
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    toggle.dataset.open = String(open);
  }

  function setupMobileNavigation() {
    const panel = document.querySelector<HTMLElement>(
      MOBILE_NAV_PANEL_SELECTOR,
    );
    const toggle = document.querySelector<HTMLButtonElement>(
      MOBILE_NAV_TOGGLE_SELECTOR,
    );
    if (!panel || !toggle) return;

    const sync = () => syncToggle(toggle, panel.matches(":popover-open"));

    panel.addEventListener("toggle", sync);
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        panel.hidePopover();
      }
    });

    const desktopNavigation = window.matchMedia("(min-width: 769px)");
    desktopNavigation.addEventListener("change", (event) => {
      if (event.matches && panel.matches(":popover-open")) {
        panel.hidePopover();
      }
    });

    sync();
  }

  setupMobileNavigation();
</script>

<style>
  /* Hallmark · pre-emit critique: P5 H4 E4 S5 R5 V4
   * Hallmark · component: mobile-navigation · genre: playful · theme: existing suzuuuuuu09.com
   * states: default · open · hover · focus-visible · active · disabled
   * loading · error · success: not applicable to navigation links
   * contrast: inherited from verified sz.* semantic tokens
   */
  .mobile-navigation__icon {
    position: absolute;
    transition:
      opacity var(--durations-fast) var(--easings-out),
      transform var(--durations-fast) var(--easings-out);
  }

  .mobile-navigation__toggle {
    width: 2.375rem;
    height: 2.375rem;
  }

  .mobile-navigation__toggle::before {
    position: absolute;
    inset: -0.1875rem;
    content: "";
  }

  .mobile-navigation__icon--close {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  .mobile-navigation__toggle[data-open="true"]
    .mobile-navigation__icon--menu {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  .mobile-navigation__toggle[data-open="true"]
    .mobile-navigation__icon--close {
    opacity: 1;
    transform: none;
  }

  .mobile-navigation__panel {
    position: fixed;
    inset-block: 5.5rem auto;
    inset-inline: 1rem;
    width: calc(100% - 2rem);
    max-width: var(--sizes-5xl);
    margin: 0 auto;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity var(--durations-normal) var(--easings-out),
      transform var(--durations-normal) var(--easings-out),
      display var(--durations-normal) allow-discrete,
      overlay var(--durations-normal) allow-discrete;
  }

  .mobile-navigation__link {
    min-height: 2.75rem;
  }

  .mobile-navigation__panel:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .mobile-navigation__panel:popover-open {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-navigation__icon,
    .mobile-navigation__panel {
      transition-duration: var(--durations-fast);
    }

    .mobile-navigation__panel,
    .mobile-navigation__panel:popover-open,
    .mobile-navigation__icon,
    .mobile-navigation__icon--close {
      transform: none;
    }
  }
</style>
