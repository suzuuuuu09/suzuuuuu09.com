---
import { css } from "styled-system/css";
import BlogCard from "@/components/features/blog/BlogCard.astro";
import { Expand } from "@/components/shared/Expand";
import { SectionLayout } from "@/components/shared/SectionLayout";
import SectionTitle from "@/components/shared/SectionTitle.astro";
import Button from "@/components/ui/Button.astro";
import { Grid } from "@/components/ui/Grid";
import { HOME_SECTION_ENTRY_LIMIT } from "@/consts/base";
import { getBlogPosts } from "@/lib/post";

const posts = (await getBlogPosts()).slice(0, HOME_SECTION_ENTRY_LIMIT);
---

<SectionLayout>
  <SectionTitle>Recent Posts</SectionTitle>
  <Expand>
    {
      posts.length === 0 ? (
        <p>No blog posts found.</p>
      ) : (
        <Grid variant="article">
          {posts.map((blog) => (
            <BlogCard
              blog={{
                id: blog.id,
                data: {
                  ...blog.data,
                  slug: blog.data.slug ?? blog.id,
                  content: blog.body,
                },
              }}
              isDraft={!blog.data.isPublish}
            />
          ))}
        </Grid>
      )
    }
  </Expand>
  <div class={css({ display: "flex", justifyContent: "center", mt: "8" })}>
    <Button href="/blog/1/">記事一覧へ</Button>
  </div>
</SectionLayout>
