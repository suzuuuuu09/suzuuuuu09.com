# Cache static assets from content.suzuuuuu09.com for 30 days
# https://content.suzuuuuu09.com/*
#   Cache-Control: public, max-age=2592000, immutable

# Cache images from content.suzuuuuu09.com for 30 days
# Note: This will be handled by Cloudflare R2 bucket settings
# but we can set hints for our own cached resources

# Security and default cache headers for static asset responses.
/*
	Strict-Transport-Security: max-age=31536000
	X-Frame-Options: DENY
	Permissions-Policy: geolocation=(), microphone=(), camera=()
	Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Cache-Control: public, max-age=60, s-maxage=3600, must-revalidate

# Asset-specific cache policies must detach the page policy above.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/llms.txt
  Content-Type: text/plain; charset=utf-8

/*.md
  Content-Type: text/markdown; charset=utf-8

/*.html
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate
	
