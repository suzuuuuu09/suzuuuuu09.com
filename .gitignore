# Track only portable, non-secret Obsidian settings.
# Keep workspace state, themes, plugin binaries/data, and credentials ignored.
!src/content/.obsidian/
src/content/.obsidian/*
!src/content/.obsidian/app.json
!src/content/.obsidian/appearance.json
!src/content/.obsidian/community-plugins.json
!src/content/.obsidian/core-plugins.json
!src/content/.obsidian/hotkeys.json
!src/content/.obsidian/daily-notes.json
!src/content/.obsidian/templates.json
!src/content/.obsidian/command-palette.json
!src/content/.obsidian/snippets/
src/content/.obsidian/snippets/*
!src/content/.obsidian/snippets/*.css

