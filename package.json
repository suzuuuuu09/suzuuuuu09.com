		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@giscus/react": "^3.1.0",
		"@r4ai/remark-callout": "^0.6.2",
		"@resvg/resvg-js": "^2.6.2",
