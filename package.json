{
	"name": "v2.suzuuuuu09.com",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": "24.19.0",
		"pnpm": "11.25.0"
	},
	"scripts": {
		"prepare": "panda codegen",
		"prebuild": "pnpm exec playwright install chromium",
		"dev": "dotenvx run -- astro dev",
		"dev:host": "dotenvx run -- astro dev --host",
		"build": "node scripts/build.mjs",
		"build:production": "node scripts/build-production.mjs",
		"build:check": "pnpm run prebuild && node scripts/build.mjs --check",
		"content:fetch": "node scripts/fetch-private-content.mjs",
		"verify:public-boundary": "node scripts/verify-public-boundary.mjs",
		"preview": "dotenvx run -- wrangler dev",
		"deploy": "pnpm run build && wrangler deploy --config dist/server/wrangler.json",
		"check:worker": "node scripts/check-worker-routes.mjs",
		"astro": "dotenvx run -- astro",
		"test": "tsx --test tests/*.test.* tools/publish-desk/tests/*.test.ts",
		"format": "biome format --write .",
		"lint": "biome check ."
	},
	"dependencies": {
		"@ark-ui/react": "^5.39.1",
		"@astrojs/check": "^0.9.10",
