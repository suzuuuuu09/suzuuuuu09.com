{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "v2-suzuuuuu09-com",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-28",
	"workers_dev": true,
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "64b46264e4324383a3332e9aeac5f78f" }
	],
	"previews": {
		"kv_namespaces": [
			{ "binding": "SESSION", "id": "ccfb94aed2de48a0a2c71788f1c7298d" }
		]
	},
	"routes": [{ "pattern": "suzuuuuu09.com", "custom_domain": true }],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "none",
		"run_worker_first": [
			"/",
			"/index.html",
			"/about*",
			"/blog*",
			"/product*",
			"/privacy-policy*",
			"!/blog/*.md",
			"!/product/*.md"
		]
	}
}
